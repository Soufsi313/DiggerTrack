<?xml version="1.0" encoding="utf-8" ?>

<!--
    Page des alertes DiggerTrack.

    Elle permettra de consulter et gérer les règles d'alerte
    associées aux produits suivis.
-->

<ContentPage
    x:Class="DiggerTrack.App.AlertsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Alertes"
    BackgroundColor="#0D0D0D">

    <VerticalStackLayout
        MaximumWidthRequest="1000"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Padding="40"
        Spacing="18">

        <Label
            Text="🔔"
            FontSize="50"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Mes alertes"
            FontSize="32"
            FontAttributes="Bold"
            TextColor="White"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Configurez vos alertes pour être averti lorsqu'un produit atteint le prix ou la réduction que vous recherchez."
            MaximumWidthRequest="650"
            FontSize="16"
            TextColor="#BDBDBD"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Aucune alerte configurée pour le moment."
            Margin="0,20,0,0"
            FontSize="14"
            TextColor="#777777"
            HorizontalTextAlignment="Center" />

    </VerticalStackLayout>

</ContentPage>