<?xml version="1.0" encoding="utf-8" ?>

<!--
    Page des produits favoris de DiggerTrack.

    Elle accueillera plus tard les produits suivis par l'utilisateur,
    leur prix actuel, leur boutique et leurs éventuelles variations.
-->

<ContentPage
    x:Class="DiggerTrack.App.FavoritesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Favoris"
    BackgroundColor="#0D0D0D">

    <VerticalStackLayout
        MaximumWidthRequest="1000"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Padding="40"
        Spacing="18">

        <Label
            Text="♡"
            FontSize="55"
            TextColor="#D4AF37"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Mes favoris"
            FontSize="32"
            FontAttributes="Bold"
            TextColor="White"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Retrouvez ici les produits dont vous souhaitez suivre le prix."
            FontSize="16"
            TextColor="#BDBDBD"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Vous ne suivez encore aucun produit."
            Margin="0,20,0,0"
            FontSize="14"
            TextColor="#777777"
            HorizontalTextAlignment="Center" />

    </VerticalStackLayout>

</ContentPage>