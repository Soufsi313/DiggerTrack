<?xml version="1.0" encoding="utf-8" ?>

<!--
    Page des produits favoris de DiggerTrack.

    Chaque carte représente désormais un produit unique.
    Les différentes offres commerciales de ce produit
    sont affichées à l'intérieur de la même carte.

    Structure :
    Product
        -> StoreOffer
        -> StoreOffer
        -> StoreOffer
-->

<ContentPage
    x:Class="DiggerTrack.App.FavoritesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Favoris"
    BackgroundColor="#0D0D0D">

    <Grid
        Padding="30"
        RowDefinitions="Auto,*"
        RowSpacing="25">

        <!-- =====================================================
             EN-TÊTE
             ===================================================== -->

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="8">

            <Label
                Text="Mes favoris"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="White" />

            <Label
                Text="Comparez les offres disponibles pour vos produits suivis."
                FontSize="16"
                TextColor="#BDBDBD" />

        </VerticalStackLayout>

        <!-- =====================================================
             LISTE DES PRODUITS
             ===================================================== -->

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Products}"
            SelectionMode="None">

            <!-- Affichage lorsque la liste est vide -->
            <CollectionView.EmptyView>

                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="12">

                    <Label
                        Text="♡"
                        FontSize="55"
                        TextColor="#D4AF37"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Aucun produit favori"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Les produits que vous suivrez apparaîtront ici."
                        FontSize="14"
                        TextColor="#777777"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <!-- =================================================
                 CARTE D'UN PRODUIT
                 ================================================= -->

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,0,0,20"
                        Padding="24"
                        BackgroundColor="#181818"
                        Stroke="#333333"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="18">

                            <!-- Informations générales du produit -->
                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="5">

                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Label
                                        Text="{Binding Category}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="#D4AF37" />

                                </VerticalStackLayout>

                                <!-- Indique que le produit est suivi -->
                                <Label
                                    Grid.Column="1"
                                    Text="♥"
                                    FontSize="25"
                                    TextColor="#D4AF37"
                                    VerticalOptions="Center" />

                            </Grid>

                            <!-- Séparation visuelle -->
                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="#333333" />

                            <!-- =====================================
                                 OFFRES DU PRODUIT
                                 ===================================== -->

                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding Offers}"
                                Spacing="8">

                                <BindableLayout.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                                            Padding="15"
                                            BackgroundColor="#202020"
                                            Stroke="#303030"
                                            StrokeThickness="1">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>

                                            <Grid
                                                ColumnDefinitions="*,Auto,Auto"
                                                ColumnSpacing="25">

                                                <!-- Boutique -->
                                                <VerticalStackLayout
                                                    Grid.Column="0"
                                                    VerticalOptions="Center"
                                                    Spacing="3">

                                                    <Label
                                                        Text="{Binding StoreName}"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        TextColor="White" />

                                                    <Label
                                                        Text="{Binding LastCheckedAt,
                                                                       StringFormat='Vérifié le {0:dd/MM/yyyy HH:mm}'}"
                                                        FontSize="11"
                                                        TextColor="#777777" />

                                                </VerticalStackLayout>

                                                <!-- Prix -->
                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="End"
                                                    Spacing="2">

                                                    <Label
                                                        Text="{Binding CurrentPrice,
                                                                       StringFormat='{0:F2} €'}"
                                                        FontSize="18"
                                                        FontAttributes="Bold"
                                                        TextColor="White"
                                                        HorizontalTextAlignment="End" />

                                                    <Label
                                                        Text="{Binding OriginalPrice,
                                                                       StringFormat='au lieu de {0:F2} €'}"
                                                        FontSize="11"
                                                        TextColor="#777777"
                                                        HorizontalTextAlignment="End" />

                                                </VerticalStackLayout>

                                                <!-- Réduction -->
                                                <Border
                                                    Grid.Column="2"
                                                    Padding="10,5"
                                                    BackgroundColor="#2A2514"
                                                    Stroke="#D4AF37"
                                                    StrokeThickness="1"
                                                    VerticalOptions="Center">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>

                                                    <Label
                                                        Text="{Binding DiscountPercentage,
                                                                       StringFormat='-{0:F2} %'}"
                                                        FontSize="13"
                                                        FontAttributes="Bold"
                                                        TextColor="#D4AF37" />

                                                </Border>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>