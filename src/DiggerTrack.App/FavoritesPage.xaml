<?xml version="1.0" encoding="utf-8" ?>

<!--
    Page des produits favoris de DiggerTrack.

    Cette page affiche les produits présents dans FavoritesViewModel.
    Chaque produit est présenté sous forme de carte avec :
    - son nom ;
    - la boutique suivie ;
    - son prix actuel ;
    - son prix de référence ;
    - son pourcentage de réduction ;
    - la date de dernière vérification.

    Les données sont actuellement temporaires.
    Elles seront remplacées plus tard par les données persistées
    et récupérées depuis les différentes boutiques.
-->

<ContentPage
    x:Class="DiggerTrack.App.FavoritesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Favoris"
    BackgroundColor="#0D0D0D">

    <Grid
        Padding="30"
        RowDefinitions="Auto,*"
        RowSpacing="25">

        <!-- =====================================================
             EN-TÊTE DE LA PAGE
             ===================================================== -->

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="8">

            <Label
                Text="Mes favoris"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="White" />

            <Label
                Text="Suivez l'évolution des prix de vos produits favoris."
                FontSize="16"
                TextColor="#BDBDBD" />

        </VerticalStackLayout>

        <!-- =====================================================
             LISTE DES PRODUITS FAVORIS
             ===================================================== -->

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Products}"
            SelectionMode="None">

            <!--
                Message affiché automatiquement lorsque
                la collection Products est vide.
            -->
            <CollectionView.EmptyView>

                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="12">

                    <Label
                        Text="♡"
                        FontSize="55"
                        TextColor="#D4AF37"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Aucun produit favori"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Les produits que vous suivrez apparaîtront ici."
                        FontSize="14"
                        TextColor="#777777"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <!--
                Apparence utilisée pour chaque produit
                contenu dans FavoritesViewModel.Products.
            -->
            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,0,0,15"
                        Padding="22"
                        BackgroundColor="#181818"
                        Stroke="#333333"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="25"
                            RowSpacing="8">

                            <!-- Nom du produit -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding Name}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="White"
                                LineBreakMode="TailTruncation" />

                            <!-- Boutique -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding StoreName}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#D4AF37" />

                            <!-- Dernière vérification -->
                            <HorizontalStackLayout
                                Grid.Row="2"
                                Grid.Column="0"
                                Spacing="4">

                                <Label
                                    Text="Dernière vérification :"
                                    FontSize="12"
                                    TextColor="#777777" />

                                <Label
                                    Text="{Binding LastCheckedAt,
                                                   StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                    FontSize="12"
                                    TextColor="#777777" />

                            </HorizontalStackLayout>

                            <!-- Prix -->
                            <VerticalStackLayout
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Grid.Column="1"
                                VerticalOptions="Center"
                                HorizontalOptions="End"
                                Spacing="3">

                                <!-- Prix actuel -->
                                <Label
                                    Text="{Binding CurrentPrice,
                                                   StringFormat='{0:F2} €'}"
                                    FontSize="23"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalTextAlignment="End" />

                                <!-- Prix de référence -->
                                <Label
                                    Text="{Binding OriginalPrice,
                                                   StringFormat='Prix initial : {0:F2} €'}"
                                    FontSize="12"
                                    TextColor="#777777"
                                    HorizontalTextAlignment="End" />

                                <!-- Réduction calculée -->
                                <Label
                                    Text="{Binding DiscountPercentage,
                                                   StringFormat='-{0:F2} %'}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="#D4AF37"
                                    HorizontalTextAlignment="End" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>