<?xml version="1.0" encoding="utf-8" ?>

<!--
    Page d'accueil principale de DiggerTrack.

    Cette première version met en place :
    - l'identité visuelle de l'application ;
    - le logo DiggerTrack ;
    - le message principal ;
    - la future zone de recherche multiboutique.

    Les fonctionnalités de recherche seront ajoutées ultérieurement.
-->

<ContentPage
    x:Class="DiggerTrack.App.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0D0D0D">

    <Grid>

        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="Auto" />

            <!-- Contenu principal -->
            <RowDefinition Height="*" />

            <!-- Pied de page -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- =========================================================
             EN-TÊTE
             ========================================================= -->

        <Grid
            Grid.Row="0"
            Padding="30,20"
            BackgroundColor="#151515">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Nom de l'application -->
            <Label
                Grid.Column="0"
                Text="DiggerTrack"
                TextColor="#D4AF37"
                FontSize="26"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <!-- Futur espace compte utilisateur -->
            <Button
                Grid.Column="2"
                Text="Mon compte"
                TextColor="White"
                BackgroundColor="Transparent"
                BorderColor="#D4AF37"
                BorderWidth="1"
                CornerRadius="8"
                Padding="18,8" />

        </Grid>

        <!-- =========================================================
             CONTENU PRINCIPAL
             ========================================================= -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                MaximumWidthRequest="1000"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="40"
                Spacing="20">

                <!-- Logo principal DiggerTrack -->
                <Image
                    Source="diggertrack_logo.png"
                    HeightRequest="330"
                    MaximumWidthRequest="600"
                    Aspect="AspectFit"
                    HorizontalOptions="Center" />

                <!-- Phrase principale -->
                <Label
                    Text="Trouvez. Suivez. Économisez."
                    TextColor="White"
                    FontSize="34"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <!-- Présentation -->
                <Label
                    Text="Suivez les prix de vos produits favoris sur plusieurs boutiques et soyez averti lorsqu'une offre correspond à vos critères."
                    TextColor="#BDBDBD"
                    FontSize="17"
                    MaximumWidthRequest="700"
                    HorizontalTextAlignment="Center"
                    LineHeight="1.3" />

                <!-- =================================================
                     FUTURE RECHERCHE MULTIBOUTIQUE
                     ================================================= -->

                <Border
                    Margin="0,25,0,0"
                    Padding="5"
                    MaximumWidthRequest="750"
                    HorizontalOptions="Fill"
                    BackgroundColor="#1C1C1C"
                    Stroke="#3A3A3A"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <!-- Champ de recherche -->
                        <Entry
                            Grid.Column="0"
                            Placeholder="Rechercher un produit..."
                            PlaceholderColor="#777777"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            FontSize="16"
                            Margin="10,0" />

                        <!--
                            Bouton visuel pour le moment.
                            La recherche sera connectée plus tard.
                        -->
                        <Button
                            Grid.Column="1"
                            Text="Rechercher"
                            BackgroundColor="#D4AF37"
                            TextColor="#111111"
                            FontAttributes="Bold"
                            CornerRadius="9"
                            Padding="22,12" />

                    </Grid>

                </Border>

                <!-- Information temporaire -->
                <Label
                    Text="La recherche multiboutique sera bientôt disponible."
                    TextColor="#777777"
                    FontSize="13"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </ScrollView>

        <!-- =========================================================
             PIED DE PAGE
             ========================================================= -->

        <Grid
            Grid.Row="2"
            Padding="25,15"
            BackgroundColor="#151515">

            <Label
                Text="DiggerTrack • Suivez les bonnes affaires."
                TextColor="#777777"
                FontSize="12"
                HorizontalOptions="Center" />

        </Grid>

    </Grid>

</ContentPage>